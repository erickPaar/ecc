    "file": "skills/worktree/scripts/wt.sh",
    "find": " and .baseRefName == \\\"${base#origin/}\\\")",
    "replace": ")"
  },
  {
    "label": "worklog: & kept on bash 5.2",
    "file": "skills/worktree/scripts/wt.sh",
    "find": "t=${t//'{{owner}}'/\"$owner\"}",
