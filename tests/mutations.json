    "replace": "if [[ -f $log ]]; then"
  },
  {
    "label": "merged: literal pathspecs",
    "file": "skills/worktree/scripts/wt.sh",
    "find": "[[ ${#files[@]} -gt 0 ]] && GIT_LITERAL_PATHSPECS=1 git",
    "replace": "[[ ${#files[@]} -gt 0 ]] && git"
  },
  {
    "label": "merged: rename detection off in the compare",
    "file": "skills/worktree/scripts/wt.sh",
    "find": "diff --quiet --no-renames HEAD",
    "replace": "diff --quiet HEAD",
    "redundant": "with --quiet and explicit pathspecs, pairing a delete and an add as a rename still reports a difference; the listing's --no-renames is the one that matters, and it is tested"
  },
  {
    "label": "merged: gh needs this head",
    "file": "skills/worktree/scripts/wt.sh",
    "find": "select(.headRefOid == \\\"$(git -C \"$path\" rev-parse HEAD)\\\" and ",
    "replace": "select("
  },
